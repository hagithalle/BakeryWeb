# Copy to Server/.env for local development. Server/.env is gitignored - never commit real values.

# Clerk (required - the server will not start without all three)
# Clerk Dashboard -> Configure -> API keys -> "Frontend API URL", e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# Clerk Dashboard -> Configure -> API keys -> Secret keys (sk_test_... for the development instance)
CLERK_SECRET_KEY=
# Frontend origins allowed to use the API, comma-separated (local Vite dev server below)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# AI recipe import (optional)
AI_API_KEY=
OPENAI_MODEL=
